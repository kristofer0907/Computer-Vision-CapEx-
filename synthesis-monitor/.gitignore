__pycache__/
*.py[cod]
venv/
.venv/

# Runtime data: database, snapshots, captures. data/* rather than
# data/ so the geometry files below can be re-included - git cannot
# un-ignore anything inside an ignored directory.
data/*
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.npy

# ...except the bench geometry, which is version-controlled on purpose.
# It describes one physical camera mount, but that mount is shared by every
# machine that runs this: the laptop the layouts are marked on, and the Pi
# that runs the camera. Left untracked, the Pi has no layouts to load and the
# tracker dies on startup. Re-mark with tools/mark_slots.py and commit the
# result if the camera is ever moved.
!data/camera_calibration.npz
!data/zones.json
!data/slots_*.json
!data/lane_*.json

.pytest_cache/
.vscode/
.idea/
